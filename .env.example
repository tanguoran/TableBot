# Change this one option and restart: ollama (local Qwen) or deepseek (API).
JARVIS_CHAT_PROVIDER=ollama
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Balance corresponding to zero hunger; currency-specific thresholds, not exchange rates.
DEEPSEEK_HUNGER_FULL_CNY=20
DEEPSEEK_HUNGER_FULL_USD=3
DEEPSEEK_API_KEY=
DEEPSEEK_THINK=false
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_MAX_RETRY_TOKENS=16384
DEEPSEEK_TIMEOUT=120
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=8192
OLLAMA_MAX_NUM_PREDICT=16384
OLLAMA_CHAT_TIMEOUT=300
OLLAMA_THINK=true
JARVIS_DB=data/jarvis.db
JARVIS_TIMEZONE=Asia/Tokyo
JARVIS_EMBED_MODEL=qwen3-embedding:0.6b
# Optional independent Ollama URL for embeddings (defaults to OLLAMA_URL).
# JARVIS_EMBED_URL=http://127.0.0.1:11434
JARVIS_KNOWLEDGE_DIR=knowledge
JARVIS_KNOWLEDGE_TOP_K=4
JARVIS_KNOWLEDGE_MIN_SCORE=0.5
JARVIS_DESKTOP_ENABLED=true
JARVIS_DESKTOP_BRIDGE_URL=http://127.0.0.1:18765
JARVIS_TRACE_ENABLED=true
JARVIS_TRACE_STREAM=true
JARVIS_AUTO_ENABLED=true
JARVIS_AUTO_RESUME_SECONDS=30
# Optional diagnostic directory; default is data/traces under this project.
# JARVIS_TRACE_DIR=data/traces
# Create a Doubao Search Custom API key (not an Ollama/Ark model key):
# https://console.volcengine.com/search-infinity/api-key
DOUBAO_SEARCH_API_KEY=
